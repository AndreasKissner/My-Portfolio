<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # JS und CSS: Angular haengt einen Hash an den Dateinamen,
  # bei jeder Aenderung entsteht ein neuer Name. Caching ist daher gefahrlos.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Schriften: aendern sich praktisch nie.
  <FilesMatch "\.(woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Bilder: Dateinamen bleiben beim Austauschen gleich, daher nur 7 Tage,
  # damit ausgetauschte Bilder zeitnah bei den Besuchern ankommen.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Uebersetzungen und Projektdaten: nicht cachen, damit Textaenderungen
  # sofort sichtbar sind.
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # index.html: nicht cachen, damit ein neuer Build sofort greift.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>